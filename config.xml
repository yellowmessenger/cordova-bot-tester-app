<?xml version='1.0' encoding='utf-8'?>
<widget id="ai.yellow.demoapp" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Yellow Bot Cordova</name>
    <description>Yellow.ai chatbot tester app (Cordova), using cordova-plugin-ymchat.</description>
    <author href="https://yellow.ai">Yellow.ai</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <platform name="ios">
        <!-- Recent Xcode SDKs only support iOS 15.0 and later. -->
        <preference name="deployment-target" value="15.0" />
        <hook type="before_compile" src="hooks/ios-pods-deployment-target.js" />
        <!-- Same usage strings as the iOS tester app. The plugin adds the
             microphone and speech recognition ones. -->
        <edit-config target="NSCameraUsageDescription" file="*-Info.plist" mode="merge">
            <string>To upload documents</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryUsageDescription" file="*-Info.plist" mode="merge">
            <string>App need access to your photo library to upload image</string>
        </edit-config>
        <edit-config target="NSBluetoothAlwaysUsageDescription" file="*-Info.plist" mode="merge">
            <string>App requires bluetooth permission</string>
        </edit-config>
        <edit-config target="NSLocationWhenInUseUsageDescription" file="*-Info.plist" mode="merge">
            <string>App requires location permission</string>
        </edit-config>
    </platform>

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        </config-file>
    </platform>
</widget>
